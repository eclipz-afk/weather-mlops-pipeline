# Values used by Docker Compose. Copy this file to .env and replace the
# password locally; never commit the resulting .env.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-long-local-password
S3_BUCKET=weather-mlops
S3_REGION=us-east-1
S3_RAW_PREFIX=raw/weather
S3_PROCESSED_PREFIX=processed/weather
S3_ML_PREFIX=processed/ml
S3_REPORTS_PREFIX=reports
MLFLOW_EXPERIMENT_NAME=weather-temperature-forecast
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_REGISTERED_MODEL_NAME=weather-temperature-forecaster
MLFLOW_MODEL_ALIAS=champion
SERVING_DATASET_ID=weather-kazan-2000-2026-v1

# Airflow metadata database and local UI credentials. Replace these values in
# the root .env before exposing the stack outside the local machine.
AIRFLOW_POSTGRES_PASSWORD=replace-with-a-local-password
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=replace-with-a-local-password
AIRFLOW_FERNET_KEY=mF0VfGRy_4Hxyyjt0sZqRTN1tYCfz4pH0K2MOzXJM0g=
AIRFLOW_WEBSERVER_SECRET_KEY=replace-with-a-random-local-secret

# Python code run on the Windows host uses http://localhost:9000.
# Future application containers use http://minio:9000.
